{
  "name": "sockets-resource-examples",
  "version": "1.0.0",
  "description": "Socket.io and WebRTC examples with Express server and React Vite client",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install && npm install --workspace=server && npm install --workspace=client && echo '\\n✅  All dependencies installed. Run: npm run dev'",
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"cyan,magenta\" \"npm run start --workspace=server\" \"npm run preview --workspace=client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
