# URL of the Socket.io/Express server (server/src/index.js)
# Local dev default (used automatically if unset): http://localhost:3001
VITE_SERVER_URL=https://sockets-resource-examples.onrender.com

# PeerJS broker (server/src/peer-server.js) — only relevant to the
# PeerJS examples (Connect 4, mesh). NOTE: this runs on its own port
# (3002 locally) separate from the main server. Render's free/web
# services only expose ONE public port, so this broker is NOT reachable
# at sockets-resource-examples.onrender.com unless it's deployed as its
# own Render service with its own PORT. Leave unset for local dev.
# VITE_PEERJS_HOST=
# VITE_PEERJS_PORT=
# VITE_PEERJS_SECURE=true
