# URL of the Socket.io/Express server (server/src/index.js)
# Local dev default (used automatically if unset): http://localhost:3001
VITE_SERVER_URL=https://sockets-resource-examples.onrender.com

# PeerJS broker (server/src/peer-server.js) — only relevant to the
# PeerJS examples (Connect 4, mesh). It's mounted on the same
# host/port as VITE_SERVER_URL above, so these only need setting if
# the broker is ever split onto a different origin than the main server.
# VITE_PEERJS_HOST=
# VITE_PEERJS_PORT=
# VITE_PEERJS_SECURE=true

# TURN server — REQUIRED for peers on two different real-world networks
# (different NATs/ISPs/firewalls) to connect. Without it, WebRTC falls
# back to STUN-only, which only works when peers are on the same network
# or behind simple/compatible NATs (this is why "two windows on one
# computer" works but "a friend on another network" doesn't).
#
# Free options to get credentials for testing:
#   - Metered/Open Relay: https://www.metered.ca/tools/openrelay/
#   - Twilio (free trial): https://www.twilio.com/docs/stun-turn
#   - Cloudflare Calls TURN: https://developers.cloudflare.com/calls/turn/
#
# VITE_TURN_HOST=global.relay.metered.ca
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
